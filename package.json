{
  "name": "dafeiyu-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A dark/light conversation backdrop for DeepSeek Harness: scene, character figure, and matching chrome colours.",
  "keywords": ["dsh", "dsh-plugin", "theme", "backdrop"],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./lib/assets/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/assets"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}
